{
  "manifest_version": 3,
  "name": "Cookie Injector",
  "version": "1.0",
  "key": "",
  "description": "Sets global_sid and opens the https://lottemartzetta.com/basket page.",
  "permissions": ["cookies", "tabs", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://lottemartzetta.com/*"],
  "externally_connectable": {
    "matches": ["http://localhost/*", "https://localhost/*"]
  },
  "background": {
    "service_worker": "background.js"
  }
}
